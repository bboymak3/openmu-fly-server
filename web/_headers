/assets/*
  Cache-Control: public, max-age=604800
/news.json
  Cache-Control: public, max-age=300
/config.js
  Cache-Control: public, max-age=300
# Paginas, codigo y estilos: el navegador pregunta siempre si hay version nueva
# (si no, mezcla el HTML nuevo con codigo viejo y quedan secciones en "Cargando…").
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/admin*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://mu.makeseo.app; connect-src 'self' https://mu-api.makeseo.app; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  Cache-Control: no-store
